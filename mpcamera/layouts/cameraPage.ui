  <property name="styleSheet">
   <string notr="true">QWidget {
    font-family: &quot;Inter&quot;;
    font-size: 12pt;
}

QPushButton {
    background-color: black;
    color: white;
    border-radius: 5px;
	font-weight:bold;
}

QPushButton[designClass=&quot;lightButton&quot;] {
    background-color: white;
    color: black;
    border-radius: 5px;
border: 1px solid black;
font-weight:bold;
}

QFrame[designClass=&quot;inferenceCard&quot;]{
background-color:white;
border-radius:5px;
border: 1px solid rgb(134, 134, 134);
}

/*-----------------COMBO BOX----------------------------*/


QComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 30px 6px 10px;
    font-size: 13px;
    color: #333333;
}

QComboBox:hover {
    border: 1px solid #a0a0a0;
}

QComboBox:focus {
    border: 1px solid #0078d4;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
}

/* Use a ▼ Unicode symbol instead of a PNG */
QComboBox::down-arrow {
    color: #555555;
    font-size: 12px;
    content: &quot;\25BC&quot;;  /* ▼ */
    margin-right: 8px;
}

/* Visually indicate disabled buttons (override default dark theme styles) */
QPushButton:disabled {
    background-color: #dcdcdc;
    color: #7a7a7a;
    border: 1px solid #c0c0c0;
}

QPushButton[designClass=&quot;lightButton&quot;]:disabled {
    background-color: #f5f5f5;
    color: #9a9a9a;
    border: 1px solid #d0d0d0;
}


/*-----------------SPIN BOX-------------------------------*/
QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #333333;
}

QDoubleSpinBox:hover {
    border: 1px solid #a0a0a0;
}

QDoubleSpinBox:focus {
    border: 1px solid #0078d4;
}

/* Remove the ugly default arrows styling */
QDoubleSpinBox::up-button, 
QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 20px;
}

/* Modern minimal up/down arrows */
QDoubleSpinBox::up-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/arrow-up-16.png);
    width: 10px;
    height: 10px;
}

QDoubleSpinBox::down-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/arrow-down-16.png);
    width: 10px;
    height: 10px;
}

/* Dropdown-style popup for editing (if applicable) */
QDoubleSpinBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cfcfcf;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #e6f2ff;
}

/*-----------------LINE EDIT----------------------------*/

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #333333;
    selection-background-color: #cce4ff;  /* light blue text highlight */
}

QLineEdit:hover {
    border: 1px solid #a0a0a0;
}

QLineEdit:focus {
    border: 1px solid #0078d4; /* same focus blue as combobox */
    outline: none;
}
</string>
