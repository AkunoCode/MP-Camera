  <property name="styleSheet">
   <string notr="true">QWidget {
    font-family: &quot;Inter&quot;;
    font-size: 12pt;
}

QPushButton {
    background-color: black;
    color: white;
    border-radius: 5px;
	font-weight:bold;
}

QPushButton[designClass=&quot;lightButton&quot;] {
    background-color: white;
    color: black;
    border-radius: 5px;
border: 1px solid black;
font-weight:bold;
}

QFrame[designClass=&quot;inferenceCard&quot;]{
background-color:white;
border-radius:5px;
border: 1px solid rgb(134, 134, 134);
}

/*-----------------COMBO BOX----------------------------*/


QComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 30px 6px 10px;
    font-size: 13px;
    color: #333333;
}

QComboBox:hover {
    border: 1px solid #a0a0a0;
}

QComboBox:focus {
    border: 1px solid #0078d4;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
}

/* Use a ▼ Unicode symbol instead of a PNG */
QComboBox::down-arrow {
    color: #555555;
    font-size: 12px;
    content: &quot;\25BC&quot;;  /* ▼ */
    margin-right: 8px;
}


/*-----------------SPIN BOX-------------------------------*/
QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #333333;
}

QDoubleSpinBox:hover {
    border: 1px solid #a0a0a0;
}

QDoubleSpinBox:focus {
    border: 1px solid #0078d4;
}

/* Remove the ugly default arrows styling */
QDoubleSpinBox::up-button, 
QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 20px;
}

/* Modern minimal up/down arrows */
QDoubleSpinBox::up-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/arrow-up-16.png);
    width: 10px;
    height: 10px;
}

QDoubleSpinBox::down-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/arrow-down-16.png);
    width: 10px;
    height: 10px;
}

/* Dropdown-style popup for editing (if applicable) */
QDoubleSpinBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cfcfcf;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #e6f2ff;
}

/*-----------------LINE EDIT----------------------------*/

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #333333;
    selection-background-color: #cce4ff;  /* light blue text highlight */
}

QLineEdit:hover {
    border: 1px solid #a0a0a0;
}

QLineEdit:focus {
    border: 1px solid #0078d4; /* same focus blue as combobox */
    outline: none;
}

/*-----------------TEXT EDIT----------------------------*/

QTextEdit {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #333333;
    selection-background-color: #cce4ff;  /* light blue text highlight */
    font-family: &quot;Inter&quot;;
}

QTextEdit:hover {
    border: 1px solid #a0a0a0;
}

QTextEdit:focus {
    border: 1px solid #0078d4;
    outline: none;
}

/*-----------------DATE EDIT----------------------------*/

QDateEdit {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #333333;
}

QDateEdit:hover {
    border: 1px solid #a0a0a0;
}

QDateEdit:focus {
    border: 1px solid #0078d4;
}


/*-----------------DATE EDIT (NO BUTTON OVERRIDES)----------------------------*/

QDateEdit {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #333333;
}

QDateEdit:hover {
    border: 1px solid #a0a0a0;
}

QDateEdit:focus {
    border: 1px solid #0078d4;   /* same blue as your other widgets */
}

/* Do NOT override ::drop-down, ::up-button, ::down-button, ::arrows */
/* This is why your icons disappeared. Leaving them out keeps everything visible. */

/*-----------------CALENDAR POPUP----------------------------*/

QCalendarWidget {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    font-family: &quot;Inter&quot;;
}

QCalendarWidget QToolButton {
    background: transparent;
    border: none;
    font-weight: bold;
    padding: 4px;
}

QCalendarWidget QToolButton:hover {
    background-color: #f1f1f1;
    border-radius: 4px;
}

QCalendarWidget QTableView {
    background-color: white;
    border: none;
    selection-background-color: #e6f2ff;
    selection-color: black;
}

QCalendarWidget QTableView::item:hover {
    background-color: #f3f9ff;
}

</string>
