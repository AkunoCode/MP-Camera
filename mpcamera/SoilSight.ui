          <property name="styleSheet">
           <string notr="true">/* ---- TABLE CONTAINER ---- */
QTableWidget {
    background: white;
    border: 1px solid rgb(220,220,220);
    border-radius: 12px;
    gridline-color: transparent;      /* Remove old-school grid lines */
    font-size: 14px;
    selection-background-color: rgb(230, 240, 255);
    selection-color: black;
}



/* Rounded top-left + top-right header corners */
QHeaderView::section:first {
    border-top-left-radius: 12px;
}
QHeaderView::section:last {
    border-top-right-radius: 12px;
}

/* ---- ROWS ---- */
QTableWidget::item {
    padding: 10px;
    border-bottom: 1px solid rgb(235,235,235);
}

/* Remove the last bottom border */
QTableWidget::item:last {
    border-bottom: none;
}

/* ---- SCROLLBAR ---- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: rgb(200,200,200);
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: rgb(170,170,170);
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0;
}
</string>
